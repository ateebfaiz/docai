{
  "info": { "name": "DocAI API Tests", "_postman_id": "docai-test-collection", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    {
      "name": "Health Check",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function(){pm.response.to.have.status(200);});"] } }],
      "request": { "method": "GET", "url": { "raw": "{{BASE_URL}}/health", "host": ["{{BASE_URL}}"], "path": ["health"] } }
    },
    {
      "name": "Upload Document",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', function(){pm.response.to.have.status(201);});", "const j = pm.response.json();", "pm.environment.set('DOC_ID', j.id);"] } }],
      "request": { "method": "POST", "header": [], "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "/home/ateeb/projects/ai-cli/invoice_test.png" }] }, "url": { "raw": "{{BASE_URL}}/documents", "host": ["{{BASE_URL}}"], "path": ["documents"] } }
    },
    {
      "name": "Trigger Processing",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function(){pm.response.to.have.status(200);});"] } }],
      "request": { "method": "POST", "url": { "raw": "{{BASE_URL}}/process/{{DOC_ID}}", "host": ["{{BASE_URL}}"], "path": ["process", "{{DOC_ID}}"] } }
    },
    {
      "name": "Get Document Status",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function(){pm.response.to.have.status(200);});"] } }],
      "request": { "method": "GET", "url": { "raw": "{{BASE_URL}}/documents/{{DOC_ID}}", "host": ["{{BASE_URL}}"], "path": ["documents", "{{DOC_ID}}"] } }
    }
  ],
  "variable": [{ "key": "BASE_URL", "value": "https://docai-production-424b.up.railway.app", "type": "string" }]
}
